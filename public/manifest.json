{
    "manifest_version": 3,
    "name": "AI Privacy Guard",
    "version": "1.3.0",
      "description": "Blur chat history on ChatGPT, Gemini & Claude. Hide sidebar titles during screen sharing with Presentation Mode.",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*"
    ],
    "action": {
        "default_popup": "index.html",
        "default_title": "AI Privacy Guard"
    },
    "icons": {
        "16": "security16.png",
        "48": "security48.png",
        "128": "security128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "commands": {
        "toggle-presentation-safe-mode": {
            "suggested_key": {
                "default": "Alt+Shift+P"
            },
            "description": "Toggle Presentation Safe Mode"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://chat.openai.com/*",
                "https://chatgpt.com/*",
                "https://gemini.google.com/*",
                "https://claude.ai/*"
            ],
            "js": [
                "platforms.js",
                "content.js"
            ],
            "css": [
                "privacy.css"
            ],
            "run_at": "document_start"
        }
    ]
}
